    DT --> D1["Event Log"]
    DT --> D2["Routing Engine"]
    DT --> D3["Buffer History"]
    DT --> D4["Routing and Tuning"]
    DT --> D5["Benchmarks"]
    DT --> D6["Export Data"]
    DT --> D7["Console"]
    DT --> RC
    AS --> D4
    D4 --> D5
    D1 --> MP
    D3 --> MP
